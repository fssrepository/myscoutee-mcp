{
  "mcpServers": {
    "myscoutee": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--read-only",
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges",
        "-e",
        "MYSCOUTEE_API_BASE_URL",
        "-e",
        "MYSCOUTEE_API_TOKEN",
        "-e",
        "MYSCOUTEE_CLIENT_ID",
        "myscoutee-mcp:1.3.0"
      ]
    }
  }
}
