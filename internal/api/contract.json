[
  {
    "name": "event",
    "method": "GET",
    "path": "/events/{externalId}",
    "description": "Read a managed event including its organizer link and Mingle configuration",
    "schema": {
      "type": "object",
      "properties": {
        "externalId": {
          "type": "string"
        }
      },
      "required": [
        "externalId"
      ],
      "additionalProperties": false
    },
    "parameters": [
      {
        "name": "externalId",
        "in": "path"
      }
    ]
  },
  {
    "name": "encounters",
    "method": "GET",
    "path": "/events/{externalId}/encounters",
    "description": "Read unique pairs from completed Speed meeting table rounds",
    "schema": {
      "type": "object",
      "properties": {
        "externalId": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 1000
        }
      },
      "required": [
        "externalId"
      ],
      "additionalProperties": false
    },
    "parameters": [
      {
        "name": "externalId",
        "in": "path"
      },
      {
        "name": "offset",
        "in": "query"
      },
      {
        "name": "limit",
        "in": "query"
      }
    ]
  },
  {
    "name": "inviteParticipants",
    "method": "POST",
    "path": "/events/{externalId}/invites",
    "description": "Create claimable participant invitation links for a managed event",
    "schema": {
      "type": "object",
      "properties": {
        "externalId": {
          "type": "string"
        },
        "request": {
          "type": "object",
          "required": [
            "participantIds"
          ],
          "properties": {
            "participantIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": "Caller-owned participant IDs, trimmed and unique within the batch."
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "externalId",
        "request"
      ],
      "additionalProperties": false
    },
    "parameters": [
      {
        "name": "externalId",
        "in": "path"
      }
    ]
  },
  {
    "name": "inviteGroupParticipants",
    "method": "POST",
    "path": "/groups/{groupId}/invites",
    "description": "Create claimable participant invitation links for a group administered by the token owner",
    "schema": {
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string"
        },
        "request": {
          "type": "object",
          "required": [
            "participantIds"
          ],
          "properties": {
            "participantIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": "Caller-owned participant IDs, trimmed and unique within the batch."
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "groupId",
        "request"
      ],
      "additionalProperties": false
    },
    "parameters": [
      {
        "name": "groupId",
        "in": "path"
      }
    ]
  },
  {
    "name": "createAssets",
    "method": "POST",
    "path": "/assets",
    "description": "Create up to 1000 assets",
    "schema": {
      "type": "object",
      "properties": {
        "request": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "title",
                  "capacityTotal",
                  "quantity"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Caller-owned stable UUID."
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "Transport",
                      "Accommodation",
                      "Supplies"
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "subtitle": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "capacityTotal": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "details": {
                    "type": "string"
                  },
                  "sourceLink": {
                    "type": "string",
                    "format": "uri"
                  },
                  "routes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Required with at least one non-blank location for Accommodation assets."
                  },
                  "visibility": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    },
    "parameters": []
  },
  {
    "name": "createEvents",
    "method": "POST",
    "path": "/events",
    "description": "Create up to 1000 events",
    "schema": {
      "type": "object",
      "properties": {
        "request": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "subtitle",
                  "startAt",
                  "endAt",
                  "capacityMin",
                  "capacityMax"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Caller-owned stable UUID."
                  },
                  "title": {
                    "type": "string"
                  },
                  "subtitle": {
                    "type": "string"
                  },
                  "startAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "location": {
                    "type": "string"
                  },
                  "capacityMin": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "capacityMax": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Must be greater than or equal to capacityMin."
                  },
                  "visibility": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "active"
                    ]
                  },
                  "sourceLink": {
                    "type": "string",
                    "format": "uri",
                    "description": "External organizer event-page link, using the same contract as assets."
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "Casual",
                      "Tournament",
                      "Mingle"
                    ],
                    "description": "UI names are Standard, Tournament and Speed meeting; wire values remain unchanged.",
                    "default": "Casual"
                  },
                  "mingleConfiguration": {
                    "type": "object",
                    "required": [
                      "groupSize",
                      "plannedRounds",
                      "roundDurationMinutes",
                      "breakDurationMinutes",
                      "requireGenderBalance"
                    ],
                    "properties": {
                      "groupSize": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 20
                      },
                      "plannedRounds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "roundDurationMinutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 240
                      },
                      "breakDurationMinutes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "requireGenderBalance": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  },
                  "topics": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    },
    "parameters": []
  },
  {
    "name": "createCampaigns",
    "method": "POST",
    "path": "/campaigns",
    "description": "Create up to 1000 draft Work campaigns",
    "schema": {
      "type": "object",
      "properties": {
        "request": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "description",
                  "kind",
                  "category"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Caller-generated idempotency ID"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "work",
                      "business",
                      "both"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "technology",
                      "creative",
                      "services",
                      "education",
                      "community",
                      "other"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    },
    "parameters": []
  }
]
