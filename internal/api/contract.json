  {
    "name": "createEvents",
    "method": "POST",
    "path": "/events",
    "description": "Create up to 1000 events",
    "schema": {
      "type": "object",
      "properties": {
        "request": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "subtitle",
                  "startAt",
                  "endAt",
                  "capacityMin",
                  "capacityMax"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Caller-owned stable UUID."
                  },
                  "title": {
                    "type": "string"
                  },
                  "subtitle": {
                    "type": "string"
                  },
                  "startAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "location": {
                    "type": "string"
                  },
                  "capacityMin": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "capacityMax": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Must be greater than or equal to capacityMin."
                  },
                  "visibility": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "active"
                    ]
                  },
                  "sourceLink": {
                    "type": "string",
                    "format": "uri",
                    "description": "External organizer event-page link, using the same contract as assets."
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "Casual",
                      "Tournament",
                      "Mingle"
                    ],
                    "description": "UI names are Standard, Tournament and Speed meeting; wire values remain unchanged.",
                    "default": "Casual"
                  },
                  "mingleConfiguration": {
                    "type": "object",
                    "required": [
                      "groupSize",
                      "plannedRounds",
                      "roundDurationMinutes",
                      "breakDurationMinutes",
                      "requireGenderBalance"
                    ],
                    "properties": {
                      "groupSize": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 20
                      },
                      "plannedRounds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "roundDurationMinutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 240
                      },
                      "breakDurationMinutes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "requireGenderBalance": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  },
                  "topics": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    },
    "parameters": []
  },
